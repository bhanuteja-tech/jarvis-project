# Jarvis project - example environment configuration.
# Copy to `.env` and adjust. NEVER commit the real `.env` file.

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jarvis

# --- Greenhouse source adapter ------------------------------------------
GREENHOUSE_TIMEOUT_SECONDS=30
GREENHOUSE_MAX_RETRIES=3
# Optional JSON file mapping board_token -> company display name.
# See greenhouse_boards.example.json for the format.
# GREENHOUSE_BOARD_REGISTRY_PATH=./greenhouse_boards.json

# --- Lever source adapter (public Postings API, no auth) -----------------
LEVER_BASE_URL=https://api.lever.co/v0/postings
LEVER_TIMEOUT_SECONDS=30
LEVER_MAX_RETRIES=3
LEVER_PAGE_SIZE=50
LEVER_MAX_PAGES=200
# Optional JSON file mapping site -> company display name.
# See lever_sites.example.json for the format.
# LEVER_SITE_REGISTRY_PATH=./lever_sites.json

# --- Application --------------------------------------------------------
LOG_LEVEL=INFO

# --- Test-only variables (not read by application settings) -------------
# JARVIS_TEST_DATABASE_URL      # target DB for persistence tests (optional)
# JARVIS_RUN_LIVE_SMOKE=1       # opt-in gate for the live smoke test
# JARVIS_LIVE_SMOKE_BOARD_TOKEN # public board token for the live smoke test
