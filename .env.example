# Jarvis project - example environment configuration.
# Copy to `.env` and adjust. NEVER commit the real `.env` file.

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jarvis

# --- Greenhouse source adapter ------------------------------------------
GREENHOUSE_TIMEOUT_SECONDS=30
GREENHOUSE_MAX_RETRIES=3
# Optional JSON file mapping board_token -> company display name.
# See greenhouse_boards.example.json for the format.
# GREENHOUSE_BOARD_REGISTRY_PATH=./greenhouse_boards.json

# --- Lever source adapter (public Postings API, no auth) -----------------
LEVER_BASE_URL=https://api.lever.co/v0/postings
LEVER_TIMEOUT_SECONDS=30
LEVER_MAX_RETRIES=3
LEVER_PAGE_SIZE=50
LEVER_MAX_PAGES=200
# Optional JSON file mapping site -> company display name.
# See lever_sites.example.json for the format.
# LEVER_SITE_REGISTRY_PATH=./lever_sites.json

# --- SearchApi (Google Jobs / Google Search engines) ---------------------
# Your SearchApi API key. NEVER commit the real value; sent as a Bearer
# header only. Leave empty to disable SearchApi sources.
SEARCHAPI_API_KEY=
SEARCHAPI_TIMEOUT_SECONDS=30
# Retries consume paid quota; keep small.
SEARCHAPI_MAX_RETRIES=2
SEARCHAPI_MAX_PAGES=5

# --- Application --------------------------------------------------------
LOG_LEVEL=INFO

# --- Phase 10: LLM provider layer (Jarvis assistant surface) -------------
# Master switch. FALSE (default) => fully deterministic system, ZERO
# network calls to any provider.
JARVIS_ASSISTANT_LLM_ENABLED=false
# Provider: ollama | openai | openrouter | deepseek | moonshot | gemini | anthropic
JARVIS_LLM_PROVIDER=ollama
# Model id exactly as the provider expects it (e.g. llama3.1, gpt-4o-mini).
# Leave empty to disable even when the master flag is true.
JARVIS_LLM_MODEL=
# Base URL. For Ollama local: http://127.0.0.1:11434; production: HTTPS
# ngrok URL. Empty uses OLLAMA_BASE_URL then the loopback default.
# Never hardcoded as a production endpoint.
JARVIS_LLM_BASE_URL=
JARVIS_LLM_TIMEOUT_SECONDS=30
JARVIS_LLM_MAX_TOKENS=512
JARVIS_LLM_TEMPERATURE=0.2
# Emit `token` WS events from genuine provider deltas only.
JARVIS_LLM_STREAMING=false
# Phase 10B routing (OFF by default). When false, JARVIS_LLM_PROVIDER is
# the only client the factory builds. Routing never probes the network
# to discover vendors; fallback happens after a typed provider error.
JARVIS_LLM_ROUTING_ENABLED=false
# Empty => use JARVIS_LLM_PROVIDER as the balanced-mode default.
JARVIS_LLM_ROUTING_DEFAULT=
# lowest | balanced | ignore   (config cost tiers, NOT billing)
JARVIS_LLM_COST_PREFERENCE=balanced
# lowest | balanced | ignore
JARVIS_LLM_LATENCY_PREFERENCE=balanced
# any | local   (local = Ollama only)
JARVIS_LLM_PRIVACY_PREFERENCE=any
# Comma-separated fallback order. Unknown names are ignored.
JARVIS_LLM_FALLBACK_PROVIDERS=
# Bound for /api/llm/status health probes only.
JARVIS_LLM_HEALTH_TIMEOUT_SECONDS=3
# Server-side credentials ONLY. Never exposed to the browser.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# OPTIONAL bearer token if your Ollama tunnel is protected (e.g. ngrok +
# forward auth). Sent as Authorization: Bearer <token>; empty = no header.
# Alias: OLLAMA_AUTH_TOKEN (used only when OLLAMA_API_KEY is empty).
OLLAMA_API_KEY=
OLLAMA_AUTH_TOKEN=
# Ollama-specific URL/model aliases. JARVIS_LLM_BASE_URL / JARVIS_LLM_MODEL
# win when set. Default loopback is for local development only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# When true, non-loopback Ollama URLs MUST be HTTPS. Loopback HTTP is still
# allowed so local `ollama serve` keeps working.
JARVIS_OLLAMA_REQUIRE_HTTPS=false

# --- Phase 10C examples (copy into `.env`; never commit real tokens) -----
# Local development:
#   JARVIS_ASSISTANT_LLM_ENABLED=true
#   JARVIS_LLM_PROVIDER=ollama
#   JARVIS_LLM_BASE_URL=http://127.0.0.1:11434
#   JARVIS_LLM_MODEL=llama3.1
#   JARVIS_OLLAMA_REQUIRE_HTTPS=false
#
# Production via authenticated ngrok (browser talks ONLY to Jarvis):
#   JARVIS_ASSISTANT_LLM_ENABLED=true
#   JARVIS_LLM_PROVIDER=ollama
#   JARVIS_LLM_BASE_URL=https://<secure-ngrok-domain>
#   JARVIS_LLM_MODEL=llama3.1
#   OLLAMA_API_KEY=<tunnel-bearer-token>
#   JARVIS_OLLAMA_REQUIRE_HTTPS=true
#   JARVIS_LLM_ROUTING_ENABLED=true
#   JARVIS_LLM_FALLBACK_PROVIDERS=deepseek,gemini
# Exposing Ollama on the public internet without authentication is NOT recommended.

# Additional provider-specific credentials
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Test-only variables (not read by application settings) -------------
# JARVIS_TEST_DATABASE_URL      # target DB for persistence tests (optional)
# JARVIS_RUN_LIVE_SMOKE=1       # opt-in gate for the live smoke test
# JARVIS_LIVE_SMOKE_BOARD_TOKEN # public board token for the live smoke test
